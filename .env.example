# Copy this file to `.env.local` and paste your Supabase project keys.
# Until these are set, the app runs in demo mode on seeded mock data.
# In Vercel, set these per Environment (Production vs Preview) — see DEPLOY.md.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Runtime environment label. Gates tester-only surfaces (the feedback widget).
#   production  → real launch build (widget hidden)
#   staging     → Vercel Preview / friends-beta (widget shown)
#   development → local dev (default when unset)
VITE_APP_ENV=development
